RUST_MIN_VER="1.88.0"

inherit cargo shell-completion

DESCRIPTION="CLI tool for Forgejo"
HOMEPAGE="https://codeberg.org/forgejo-contrib/forgejo-cli"
SRC_URI="
	https://codeberg.org/forgejo-contrib/${PN}/archive/v${PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"
S="${WORKDIR}/${PN}"

LICENSE="|| ( Apache-2.0 MIT )"
# Dependent crate licenses
LICENSE+="
	Apache-2.0 BSD-2 BSD ISC MIT MPL-2.0 Unicode-3.0 Unicode-DFS-2016
	ZLIB
"
SLOT="0"
KEYWORDS="~amd64"
RESTRICT="mirror"

DEPEND=">=dev-libs/libgit2-1.9.4:="
RDEPEND="${DEPEND}"

src_configure() {
	export LIBGIT2_NO_VENDOR=1

	cargo_src_configure
}

src_install() {
	cargo_src_install

	local fj="${S}/$(cargo_target_dir)/fj"
	"${fj}" completion bash > "${T}/fj.bash" || die
	"${fj}" completion zsh > "${T}/_fj" || die
	"${fj}" completion fish > "${T}/fj.fish" || die
	newbashcomp "${T}/fj.bash" fj
	newzshcomp "${T}/_fj" _fj
	newfishcomp "${T}/fj.fish" fj.fish

	dodoc README.md
}
