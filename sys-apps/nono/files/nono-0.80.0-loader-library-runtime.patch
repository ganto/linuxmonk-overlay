+fn loader_cache_hwcaps(
+    whole: &[u8],
+    offset: usize,
+    base: usize,
+    strings_start: usize,
+    strings_end: usize,
+) -> Result<Vec<String>> {
+    if offset == 0 {
+        return Ok(Vec::new());
+    }
+    if offset % 4 != 0 || offset < base + strings_end {
+        return Err(invalid_loader_cache());
+    }
+    let directory = whole.get(offset..).ok_or_else(invalid_loader_cache)?;
+    if le_u32(directory, 0)? != 0u32.wrapping_sub(358342284) {
+        return Err(invalid_loader_cache());
+    }
+    let count = le_u32(directory, 4)? as usize;
+    if count > directory.len().saturating_sub(8) / 16 {
+        return Err(invalid_loader_cache());
+    }
+    let mut names = None;
+    for idx in 0..count {
+        let entry = 8 + idx * 16;
+        let start = le_u32(directory, entry + 8)? as usize;
+        let size = le_u32(directory, entry + 12)? as usize;
+        let end = start.checked_add(size).ok_or_else(invalid_loader_cache)?;
+        let section = whole.get(start..end).ok_or_else(invalid_loader_cache)?;
+        if le_u32(directory, entry)? != 1 {
+            continue;
+        }
+        if names.is_some()
+            || le_u32(directory, entry + 4)? != 0
+            || start % 4 != 0
+            || size == 0
+            || size % 4 != 0
+            || size > 4096
+        {
+            return Err(invalid_loader_cache());
+        }
+        let mut values = Vec::new();
+        for idx in (0..size).step_by(4) {
+            let string_offset = le_u32(section, idx)? as usize;
+            if !(base + strings_start..base + strings_end).contains(&string_offset) {
+                return Err(invalid_loader_cache());
+            }
+            values.push(read_cstr_string(
+                &whole[..(string_offset + 256).min(base + strings_end)],
+                string_offset,
+            )?);
+        }
+        names = Some(values);
+    }
+    Ok(names.unwrap_or_default())
+}
