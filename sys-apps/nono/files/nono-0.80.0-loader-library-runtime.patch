+fn resolve_cached_library(
+    cache: &LoaderCache,
+    name: &str,
+    abi: ElfAbi,
+    cpu_level: u8,
+) -> Result<Option<PathBuf>> {
+    let flags = match (abi.class, abi.machine) {
+        (2, 62) => 0x303,
+        (1, 3) => 3,
+        (1, 62) => 0x803,
+        _ => return Err(invalid_loader_cache()),
+    };
+    let mut selected: Option<&LoaderCacheEntry> = None;
+    for entry in cache.get(name).into_iter().flatten() {
+        if entry.flags != flags || entry.level > cpu_level || entry.isa >= cpu_level as u16 {
+            continue;
+        }
+        // Cache order breaks ties; active named hwcaps outrank all baselines.
+        if selected.is_none_or(|previous| entry.level > previous.level) {
+            selected = Some(entry);
+        }
+        if entry.level == 1 {
+            break;
+        }
+    }
+    // Select by metadata before touching the filesystem. glibc opens only this
+    // pathname, then tries default directories on ENOENT or wrong architecture.
+    match selected {
+        Some(entry) => open_loader_library(&entry.path, abi),
+        None => Ok(None),
+    }
+}
+
+fn open_loader_library(path: &Path, abi: ElfAbi) -> Result<Option<PathBuf>> {
+    let mut file = match File::open(path) {
+        Ok(file) => file,
+        Err(err)
+            if matches!(
+                err.raw_os_error(),
+                Some(libc::ENOENT | libc::ENOTDIR | libc::EACCES)
+            ) =>
+        {
+            return Ok(None);
+        }
+        Err(source) => {
+            return Err(NonoError::ConfigRead {
+                path: path.to_path_buf(),
+                source,
+            });
+        }
+    };
+    let mut header = [0; 64];
+    file.read_exact(&mut header)
+        .map_err(|source| NonoError::ConfigRead {
+            path: path.to_path_buf(),
+            source,
+        })?;
+    if elf_abi(&header)? != abi {
+        return Ok(None);
+    }
+    // Only shared objects, never arbitrary data files or executables.
+    if le_u16(&header, 16)? != 3 {
+        return Err(invalid_loader_cache());
+    }
+    cached_canonicalize(path).map(Some)
+}
+
+fn resolve_in_loader_dir(
+    dir: &Path,
+    name: &str,
+    abi: ElfAbi,
+    cpu_level: u8,
+) -> Result<Option<PathBuf>> {
+    for level in (2..=cpu_level).rev() {
+        let path = dir.join(format!("glibc-hwcaps/x86-64-v{level}")).join(name);
+        if let Some(path) = open_loader_library(&path, abi)? {
+            return Ok(Some(path));
+        }
+    }
+    open_loader_library(&dir.join(name), abi)
+}
