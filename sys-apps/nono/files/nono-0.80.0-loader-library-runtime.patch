+/// Query only our already-running, root-owned native interpreter, with no ELF
+/// filename argument. --list-diagnostics exits before loading any program.
+/// Unlike --list on an untrusted ELF, this cannot load its DT_AUDIT objects.
+/// Use an empty environment, a 1 MiB output limit and a two-second deadline.
+fn read_loader_cpu(interpreter: &Path) -> Result<LoaderCpu> {
+    let failure = || {
+        NonoError::SandboxInit("native glibc loader diagnostics unavailable or unsupported".into())
+    };
+    let metadata = fs::metadata(interpreter).map_err(|_| failure())?;
+    if !interpreter.is_absolute()
+        || !metadata.is_file()
+        || metadata.uid() != 0
+        || metadata.mode() & 0o022 != 0
+    {
+        return Err(failure());
+    }
+    let (mut reader, writer) = UnixStream::pair().map_err(|_| failure())?;
+    reader.set_nonblocking(true).map_err(|_| failure())?;
+    let mut child = Command::new(interpreter)
+        .arg("--list-diagnostics")
+        .env_clear()
+        .stdin(Stdio::null())
+        .stdout(OwnedFd::from(writer))
+        .stderr(Stdio::null())
+        .spawn()
+        .map_err(|_| failure())?;
+    let result = (|| {
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(2);
+        let mut output = Vec::new();
+        let mut exited = None;
+        loop {
+            let mut buffer = [0; 8192];
+            match reader.read(&mut buffer) {
+                Ok(0) if exited.is_some() => break,
+                Ok(len) => output.extend_from_slice(&buffer[..len]),
+                Err(err) if err.kind() == std::io::ErrorKind::WouldBlock => {}
+                Err(err) if err.kind() == std::io::ErrorKind::Interrupted => continue,
+                Err(_) => return Err(failure()),
+            }
+            if output.len() > 1024 * 1024 || std::time::Instant::now() >= deadline {
+                return Err(failure());
+            }
+            if exited.is_none() {
+                exited = child.try_wait().map_err(|_| failure())?;
+            }
+            std::thread::sleep(std::time::Duration::from_millis(1));
+        }
+        if !exited.is_some_and(|status| status.success()) {
+            return Err(failure());
+        }
+        parse_loader_cpu(&output)
+    })();
+    if result.is_err() {
+        let _ = child.kill();
+        let _ = child.wait();
+    }
+    result
+}
+
+fn parse_loader_cpu(output: &[u8]) -> Result<LoaderCpu> {
+    if output.len() > 1024 * 1024 {
+        return Err(invalid_loader_cache());
+    }
+    let text = std::str::from_utf8(output).map_err(|_| invalid_loader_cache())?;
+    let field = |prefix: &str| -> Result<&str> {
+        let mut matches = text.lines().filter_map(|line| line.strip_prefix(prefix));
+        let value = matches.next().ok_or_else(invalid_loader_cache)?;
+        if matches.next().is_some() {
+            return Err(invalid_loader_cache());
+        }
+        Ok(value)
+    };
+    if field("dl_hwcaps_subdirs=")? != "\"x86-64-v4:x86-64-v3:x86-64-v2\"" {
+        return Err(invalid_loader_cache());
+    }
+    let version = field("version.version=")?;
+    let minor = version
+        .strip_prefix("\"2.")
+        .and_then(|v| v.strip_suffix('"'))
+        .and_then(|v| v.parse::<u32>().ok())
+        .ok_or_else(invalid_loader_cache)?;
+    if minor < 37 {
+        return Err(invalid_loader_cache());
+    }
+    let level = match field("dl_hwcaps_subdirs_active=")? {
+        "0x0" => 1,
+        "0x4" => 2,
+        "0x6" => 3,
+        "0x7" => 4,
+        _ => return Err(invalid_loader_cache()),
+    };
+    let mut default_dirs = Vec::new();
+    for line in text
+        .lines()
+        .filter(|line| line.starts_with("path.system_dirs["))
+    {
+        let prefix = format!("path.system_dirs[0x{:x}]=", default_dirs.len());
+        let path = line
+            .strip_prefix(&prefix)
+            .and_then(|s| s.strip_prefix('"'))
+            .and_then(|s| s.strip_suffix('"'))
+            .ok_or_else(invalid_loader_cache)?;
+        if default_dirs.len() >= 32
+            || path.len() > 4096
+            || path.contains(['\\', '"'])
+            || !Path::new(path).is_absolute()
+            || Path::new(path)
+                .components()
+                .any(|c| matches!(c, std::path::Component::ParentDir))
+        {
+            return Err(invalid_loader_cache());
+        }
+        default_dirs.push(PathBuf::from(path));
+    }
+    if default_dirs.is_empty() {
+        return Err(invalid_loader_cache());
+    }
+    Ok(LoaderCpu {
+        level,
+        default_dirs,
+    })
+}
