+#[derive(Clone, Debug, Eq, PartialEq)]
+struct LoaderCpu {
+    level: u8,
+    default_dirs: Vec<PathBuf>,
+}
+
+fn native_loader_cpu() -> Result<LoaderCpu> {
+    ELF_LOADER_CPU.with(|slot| {
+        let mut slot = slot.borrow_mut();
+        let result = slot.get_or_insert_with(|| {
+            (|| -> Result<LoaderCpu> {
+                let native = cached_canonicalize(Path::new("/proc/self/exe"))?;
+                let interpreter = parse_elf_cached(&native)?
+                    .interpreter
+                    .ok_or_else(invalid_loader_cache)?;
+                read_loader_cpu(&interpreter)
+            })()
+            .map_err(|err| err.to_string())
+        });
+        result.clone().map_err(NonoError::SandboxInit)
+    })
+}
