+/// The closure is prepared before a request's environment exists. Default
+/// filtering drops LD_* but explicit export_env can re-admit them, and
+/// GLIBC_TUNABLES can arrive through set_vars/allow_vars. Reject overrides
+/// after every environment source has been applied, without logging values.
+fn validate_loader_selection_env(env: &[Vec<u8>]) -> Result<()> {
+    if cfg!(all(target_env = "gnu", target_arch = "x86_64")) {
+        for name in [
+            "GLIBC_TUNABLES",
+            "LD_HWCAP_MASK",
+            "LD_LIBRARY_PATH",
+            "LD_PRELOAD",
+            "LD_AUDIT",
+        ] {
+            let prefix = format!("{name}=");
+            if env
+                .iter()
+                .any(|entry| entry.starts_with(prefix.as_bytes()) && entry.len() > prefix.len())
+            {
+                return Err(NonoError::SandboxInit(format!(
+                    "command-mediation cannot model loader override '{name}'"
+                )));
+            }
+        }
+    }
+    Ok(())
+}
