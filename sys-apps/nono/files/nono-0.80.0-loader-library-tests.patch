+                &search_dirs,
+                None,
+                true,
+                &requester,
+            )?,
+            cached_canonicalize(&library)?
+        );
+        assert_eq!(
+            resolve_shared_library(
+                "libloader-precedence.so.1",
+                &[],
+                Some(tmp.path()),
+                true,
+                &requester,
+            )?,
+            cached_canonicalize(&library)?
+        );
+        let err = resolve_shared_library("libloader-precedence.so.1", &[], None, true, &requester)
+            .expect_err("provider errors must not turn into a grant");
+        assert!(err.to_string().contains("corrupt fixture"));
+        assert!(read_loader_cache(&tmp.path().join("absent-cache"))?.is_empty());
