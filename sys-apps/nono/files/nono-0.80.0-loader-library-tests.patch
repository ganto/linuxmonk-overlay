+    #[test]
+    fn loader_cache_parses_new_and_compat_and_ignores_hwcaps() -> Result<()> {
+        let fixture = loader_cache_fixture(&[
+            (
+                "libbase.so.1",
+                Path::new("/configured/glibc-hwcaps/x86-64-v3/libbase.so.1.2"),
+                0x303,
+                1 << 62,
+            ),
+            (
+                "libbase.so.1",
+                Path::new("/configured/libbase.so.1"),
+                0x303,
+                0,
+            ),
+            (
+                "libversioned.so.1",
+                Path::new("/configured/libversioned.so.1.2"),
+                0x303,
+                0,
+            ),
+            ("libold.so.1", Path::new("/configured/libold.so.1"), 2, 0),
+        ]);
+        let parsed = parse_loader_cache(&fixture)?;
+        assert_eq!(parsed.len(), 2);
+        assert_eq!(
+            parsed["libbase.so.1"],
+            vec![PathBuf::from("/configured/libbase.so.1")]
+        );
+        assert_eq!(
+            parsed["libversioned.so.1"],
+            vec![PathBuf::from("/configured/libversioned.so.1.2")]
+        );
+        // One old-format entry and four alignment bytes precede the new header.
+        let mut compat = vec![0; 32];
+        compat[..11].copy_from_slice(b"ld.so-1.7.0");
+        compat[12..16].copy_from_slice(&1u32.to_le_bytes());
+        compat.extend_from_slice(&fixture);
+        assert_eq!(parse_loader_cache(&compat)?, parsed);
+        Ok(())
+    }
