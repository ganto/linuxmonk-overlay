+    fn loader_cache_fixture(entries: &[(&str, &Path, u32, u64)]) -> Vec<u8> {
+        let mut data = vec![0; 48 + entries.len() * 24];
+        data[..20].copy_from_slice(b"glibc-ld.so.cache1.1");
+        data[20..24].copy_from_slice(&(entries.len() as u32).to_le_bytes());
+        data[28] = 2;
+        let strings_start = data.len();
+        for (idx, (name, path, flags, hwcap)) in entries.iter().enumerate() {
+            let offset = 48 + idx * 24;
+            data[offset..offset + 4].copy_from_slice(&flags.to_le_bytes());
+            let key = data.len() as u32;
+            data.extend_from_slice(name.as_bytes());
+            data.push(0);
+            let value = data.len() as u32;
+            data.extend_from_slice(path.as_os_str().as_bytes());
+            data.push(0);
+            data[offset + 4..offset + 8].copy_from_slice(&key.to_le_bytes());
+            data[offset + 8..offset + 12].copy_from_slice(&value.to_le_bytes());
+            data[offset + 16..offset + 24].copy_from_slice(&hwcap.to_le_bytes());
+        }
+        let strings_len = (data.len() - strings_start) as u32;
+        data[24..28].copy_from_slice(&strings_len.to_le_bytes());
+        data
+    }
+
+    fn write_loader_test_elf(path: &Path, class: u8, machine: u16) -> Result<()> {
+        let mut header = [0; 64];
+        header[..4].copy_from_slice(b"\x7fELF");
+        header[4] = class;
+        header[5] = 1;
+        header[16..18].copy_from_slice(&3u16.to_le_bytes());
+        header[18..20].copy_from_slice(&machine.to_le_bytes());
+        fs::write(path, header).map_err(|source| NonoError::ConfigWrite {
+            path: path.into(),
+            source,
+        })
+    }
+
+    #[test]
+    fn loader_cache_resolves_outside_defaults_without_granting_other_entries() -> Result<()> {
+        reset_elf_resolution_cache();
+        let tmp = test_tempdir()?;
+        let library = tmp.path().join("libloader-fixture.so.1.2");
+        let unrelated = tmp.path().join("libunrelated.so.1");
+        let requester = tmp.path().join("program");
+        write_loader_test_elf(&library, 2, 62)?;
+        write_loader_test_elf(&unrelated, 2, 62)?;
+        write_loader_test_elf(&requester, 2, 62)?;
+        let fixture = loader_cache_fixture(&[
+            ("libloader-fixture.so.1", &library, 0x303, 0),
+            ("libunrelated.so.1", &unrelated, 0x303, 0),
+        ]);
+        let cache = parse_loader_cache(&fixture)?;
+        ELF_LOADER_CACHE.with(|slot| *slot.borrow_mut() = Some(Ok(cache)));
+
+        let resolved =
+            resolve_shared_library("libloader-fixture.so.1", &[], None, true, &requester)?;
+        assert_eq!(resolved, cached_canonicalize(&library)?);
+        let mut closure = Vec::new();
+        resolve_elf_recursive(&resolved, None, true, &mut HashSet::new(), &mut closure)?;
+        assert_eq!(closure, vec![resolved]);
+        assert!(!closure.contains(&cached_canonicalize(&unrelated)?));
+        assert!(
+            resolve_shared_library("libloader-missing.so.1", &[], None, true, &requester).is_err()
+        );
+
+        // Resolution results and the loader snapshot must not leak into a new pass.
+        reset_elf_resolution_cache();
+        ELF_LOADER_CACHE.with(|slot| *slot.borrow_mut() = Some(Ok(HashMap::new())));
+        assert!(
+            resolve_shared_library("libloader-fixture.so.1", &[], None, true, &requester).is_err()
+        );
+        Ok(())
+    }
