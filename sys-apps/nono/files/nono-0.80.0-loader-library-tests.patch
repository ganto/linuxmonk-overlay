+    #[test]
+    fn loader_cache_rejects_malformed_data_and_paths() {
+        let fixture = loader_cache_fixture(&[(
+            "libtest.so.1",
+            Path::new("/configured/libtest.so.1"),
+            0x303,
+            0,
+        )]);
+        for end in 0..fixture.len() {
+            assert!(parse_loader_cache(&fixture[..end]).is_err(), "prefix {end}");
+        }
+        for (offset, value) in [(20, u32::MAX), (24, u32::MAX), (52, u32::MAX), (56, 0)] {
+            let mut malformed = fixture.clone();
+            malformed[offset..offset + 4].copy_from_slice(&value.to_le_bytes());
+            assert!(parse_loader_cache(&malformed).is_err());
+        }
+        for endian in [1, 3] {
+            let mut malformed = fixture.clone();
+            malformed[28] = endian;
+            assert!(parse_loader_cache(&malformed).is_err());
+        }
+        for (name, path) in [
+            ("libtest.so.1", "relative/libtest.so.1"),
+            ("libtest.so.1", "/configured/../libtest.so.1"),
+            ("../libtest.so.1", "/configured/libtest.so.1"),
+            ("libtest.so.1", "/"),
+        ] {
+            assert!(
+                parse_loader_cache(&loader_cache_fixture(&[(name, Path::new(path), 0x303, 0)]))
+                    .is_err()
+            );
+        }
+        assert!(parse_loader_cache(&vec![0; MAX_LOADER_CACHE_BYTES + 1]).is_err());
+    }
