+    #[test]
+    fn loader_cache_checks_abi_stale_entries_and_first_match() -> Result<()> {
+        reset_elf_resolution_cache();
+        let tmp = test_tempdir()?;
+        let native = tmp.path().join("native");
+        let other = tmp.path().join("other");
+        let foreign = tmp.path().join("foreign");
+        write_loader_test_elf(&native, 2, 62)?;
+        write_loader_test_elf(&other, 2, 62)?;
+        write_loader_test_elf(&foreign, 1, 3)?;
+        let abi = elf_abi(&fs::read(&native).expect("read test ELF"))?;
+        let mut cache = HashMap::from([(
+            "libtest.so.1".into(),
+            vec![
+                tmp.path().join("stale"),
+                foreign.clone(),
+                native.clone(),
+                native.clone(),
+            ],
+        )]);
+        assert_eq!(
+            resolve_cached_library(&cache, "libtest.so.1", abi)?,
+            Some(cached_canonicalize(&native)?)
+        );
+        assert_eq!(resolve_cached_library(&cache, "libabsent.so.1", abi)?, None);
+        // A cached result for one ELF class must not be reused for another.
+        let requester64 = tmp.path().join("requester64");
+        let requester32 = tmp.path().join("requester32");
+        write_loader_test_elf(&requester64, 2, 62)?;
+        write_loader_test_elf(&requester32, 1, 3)?;
+        ELF_LOADER_CACHE.with(|slot| *slot.borrow_mut() = Some(Ok(cache.clone())));
+        assert_eq!(
+            resolve_shared_library("libtest.so.1", &[], None, true, &requester64,)?,
+            cached_canonicalize(&native)?
+        );
+        assert_eq!(
+            resolve_shared_library("libtest.so.1", &[], None, true, &requester32,)?,
+            cached_canonicalize(&foreign)?
+        );
+        assert!(
+            resolve_shared_library("libtest.so.1", &[], None, false, &requester64,).is_err(),
+            "non-native loaders must ignore the glibc cache"
+        );
+        cache.insert("libtest.so.1".into(), vec![foreign]);
+        assert_eq!(resolve_cached_library(&cache, "libtest.so.1", abi)?, None);
+        // Slotted libraries can have the same SONAME and ABI. Only the first
+        // eligible path in cache order must be returned, never all slots.
+        let ordered = loader_cache_fixture(&[
+            ("libtest.so.1", &native, 0x303, 0),
+            ("libtest.so.1", &other, 0x303, 0),
+        ]);
+        cache = parse_loader_cache(&ordered)?;
+        assert_eq!(
+            resolve_cached_library(&cache, "libtest.so.1", abi)?,
+            Some(cached_canonicalize(&native)?)
+        );
+        cache
+            .get_mut("libtest.so.1")
+            .expect("fixture SONAME")
+            .reverse();
+        assert_eq!(
+            resolve_cached_library(&cache, "libtest.so.1", abi)?,
+            Some(cached_canonicalize(&other)?)
+        );
+        fs::write(&other, b"not an ELF library").expect("replace test ELF");
+        cache.insert("libtest.so.1".into(), vec![native.clone(), other.clone()]);
+        assert_eq!(
+            resolve_cached_library(&cache, "libtest.so.1", abi)?,
+            Some(cached_canonicalize(&native)?)
+        );
+        cache.insert("libtest.so.1".into(), vec![other]);
+        assert!(resolve_cached_library(&cache, "libtest.so.1", abi).is_err());
+        Ok(())
+    }
