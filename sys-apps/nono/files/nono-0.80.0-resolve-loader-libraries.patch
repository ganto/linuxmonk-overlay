+#[derive(Clone, Copy, Debug, Eq, Hash, PartialEq)]
+struct ElfAbi {
+    class: u8,
+    machine: u16,
+    flags: u32,
+}
+
+fn elf_abi(data: &[u8]) -> Result<ElfAbi> {
+    if data.len() < 64 || &data[..4] != b"\x7fELF" || data[5] != 1 {
+        return Err(NonoError::SandboxInit(
+            "invalid cached library ELF header".into(),
+        ));
+    }
+    let flags_offset = match data[4] {
+        1 => 36,
+        2 => 48,
+        _ => {
+            return Err(NonoError::SandboxInit(
+                "invalid cached library ELF class".into(),
+            ));
+        }
+    };
+    Ok(ElfAbi {
+        class: data[4],
+        machine: le_u16(data, 18)?,
+        flags: le_u32(data, flags_offset)?,
+    })
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+struct LoaderCacheEntry {
+    path: PathBuf,
+    flags: u32,
+    level: u8,
+    isa: u16,
+}
+
+type LoaderCache = HashMap<String, Vec<LoaderCacheEntry>>;
+const MAX_LOADER_CACHE_BYTES: usize = 16 * 1024 * 1024;
+
+fn invalid_loader_cache() -> NonoError {
+    NonoError::SandboxInit("invalid or unsupported glibc loader cache".into())
+}
+
+fn read_loader_cache(path: &Path) -> Result<LoaderCache> {
+    let file = match File::open(path) {
+        Ok(file) => file,
+        Err(err) if err.kind() == std::io::ErrorKind::NotFound => return Ok(HashMap::new()),
+        Err(source) => {
+            return Err(NonoError::ConfigRead {
+                path: path.into(),
+                source,
+            });
+        }
+    };
+    let metadata = file.metadata().map_err(|source| NonoError::ConfigRead {
+        path: path.into(),
+        source,
+    })?;
+    if !metadata.is_file() || metadata.uid() != 0 || metadata.mode() & 0o022 != 0 {
+        return Err(invalid_loader_cache());
+    }
+    let mut data = Vec::new();
+    file.take((MAX_LOADER_CACHE_BYTES + 1) as u64)
+        .read_to_end(&mut data)
+        .map_err(|source| NonoError::ConfigRead {
+            path: path.into(),
+            source,
+        })?;
+    parse_loader_cache(&data)
+}
