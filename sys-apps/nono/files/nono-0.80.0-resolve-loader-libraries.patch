+/// glibc's sysdeps/generic/dl-cache.h defines the 48-byte v1.1 header and
+/// 24-byte entries. Accept new and compat caches, not legacy libc5 caches.
+/// Offsets are relative to the new header, including in a compat cache.
+fn parse_loader_cache(data: &[u8]) -> Result<LoaderCache> {
+    if data.len() > MAX_LOADER_CACHE_BYTES {
+        return Err(invalid_loader_cache());
+    }
+    let base = if data.starts_with(b"ld.so-1.7.0") {
+        let old_count = le_u32(data, 12)? as usize;
+        old_count
+            .checked_mul(12)
+            .and_then(|n| n.checked_add(16 + 7))
+            .map(|n| n & !7)
+            .ok_or_else(invalid_loader_cache)?
+    } else {
+        0
+    };
+    let whole = data;
+    let data = whole.get(base..).ok_or_else(invalid_loader_cache)?;
+    if data.len() < 48
+        || !data.starts_with(b"glibc-ld.so.cache1.1")
+        || !matches!(data[28] & 3, 0 | 2)
+    {
+        return Err(invalid_loader_cache());
+    }
+    let count = le_u32(data, 20)? as usize;
+    let strings_start = count
+        .checked_mul(24)
+        .and_then(|n| n.checked_add(48))
+        .ok_or_else(invalid_loader_cache)?;
+    let strings_end = strings_start
+        .checked_add(le_u32(data, 24)? as usize)
+        .filter(|end| *end <= data.len())
+        .ok_or_else(invalid_loader_cache)?;
+    let string = |offset: u32, limit: usize| -> Result<String> {
+        let offset = offset as usize;
+        if !(strings_start..strings_end).contains(&offset) {
+            return Err(invalid_loader_cache());
+        }
+        let end = offset.saturating_add(limit + 1).min(strings_end);
+        read_cstr_string(&data[..end], offset)
+    };
+    // Extension-directory and hwcaps string offsets are file-relative, unlike
+    // the library string offsets. This matters for old/new compat caches.
+    let hwcaps = loader_cache_hwcaps(
+        whole,
+        le_u32(data, 32)? as usize,
+        base,
+        strings_start,
+        strings_end,
+    )?;
+    let mut entries = LoaderCache::new();
+    let mut decoded_bytes = 0usize;
+    for idx in 0..count {
+        let offset = 48 + idx * 24; // count and table bounds checked above
+        let flags = le_u32(data, offset)?;
+        if flags & 0xff != 3 {
+            continue;
+        }
+        let hwcap = le_u64(data, offset + 16)?;
+        let mut level = 1;
+        let mut isa = 0;
+        if hwcap != 0 {
+            // Legacy hwcaps were removed in glibc 2.37. The diagnostic reader
+            // requires that version or later, so only named extensions apply.
+            if (hwcap >> 32) & !0x3ff != 1 << 30 {
+                continue;
+            }
+            isa = ((hwcap >> 32) & 0x3ff) as u16;
+            if isa > 3 {
+                return Err(invalid_loader_cache());
+            }
+            let name = hwcaps
+                .get(hwcap as u32 as usize)
+                .ok_or_else(invalid_loader_cache)?;
+            level = match name.as_str() {
+                "x86-64-v2" => 2,
+                "x86-64-v3" => 3,
+                "x86-64-v4" => 4,
+                _ => continue, // not a native x86-64 built-in directory
+            };
+        }
+        let name = string(le_u32(data, offset + 4)?, 255)?;
+        let path = PathBuf::from(string(le_u32(data, offset + 8)?, 4096)?);
+        decoded_bytes = decoded_bytes.saturating_add(name.len() + path.as_os_str().len());
+        if decoded_bytes > MAX_LOADER_CACHE_BYTES {
+            return Err(invalid_loader_cache());
+        }
+        // Cache entries must name one library, never directories or searches.
+        if name.is_empty()
+            || name.contains('/')
+            || !path.is_absolute()
+            || path.file_name().is_none()
+            || path
+                .components()
+                .any(|c| matches!(c, std::path::Component::ParentDir))
+        {
+            return Err(invalid_loader_cache());
+        }
+        // Preserve cache order within each exact SONAME. Filename and SONAME
+        // are independent fields; the trusted cache supplies their mapping.
+        entries.entry(name).or_default().push(LoaderCacheEntry {
+            path,
+            flags,
+            level,
+            isa,
+        });
+    }
+    Ok(entries)
 }
 
