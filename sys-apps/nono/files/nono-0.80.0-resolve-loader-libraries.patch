+/// Use the system cache only for our own glibc interpreter. In particular, a
+/// musl or another glibc interpreter must not acquire host dependencies.
+/// Both interpreter paths are canonical, including symlinks to versioned ld.so.
+fn uses_native_glibc_cache(interpreter: Option<&Path>) -> Result<bool> {
+    if !cfg!(all(target_env = "gnu", target_arch = "x86_64")) || interpreter.is_none() {
+        return Ok(false);
+    }
+    let native = cached_canonicalize(Path::new("/proc/self/exe"))?;
+    let parsed = parse_elf_cached(&native)?;
+    Ok(parsed.interpreter.as_deref() == interpreter)
+}
