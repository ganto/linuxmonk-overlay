+    // With no operand after -c's script, sh keeps its native argv[0] in $0.
+    #[cfg(unix)]
+    const CAPTURE_ARGV0_SCRIPT: &str =
+        r#"[ "$0" = "$NONO_REQUEST_PATH" ] || exit 42; printf %s capture-token"#;
+
+    #[cfg(unix)]
+    const PROVIDER_ARGV0_SCRIPT: &str = r#"IFS= read -r request || :
+[ -n "$request" ] || exit 43
+[ "$0" = "$NONO_REQUEST_PATH" ] || exit 42
+printf '%s' '{"material":{"type":"secret","value":"provider-token"}}'"#;
+
+    #[cfg(unix)]
+    fn capture_argv0_backend(
+        command: String,
+        script: &str,
+        provider: bool,
+    ) -> Result<ProxyCredentialCaptureBackend> {
+        let args = vec![command, "-c".to_string(), script.to_string()];
+        let mut entry =
+            test_capture_entry_no_cache(if provider { Vec::new() } else { args.clone() });
+        if provider {
+            entry.provider = Some(crate::profile::CredentialCaptureProvider {
+                command: args,
+                config: serde_json::json!({}),
+            });
+        }
+        let mut entries = HashMap::new();
+        entries.insert("argv0_fixture".to_string(), entry);
+        ProxyCredentialCaptureBackend::new(&entries, "sess-argv0".into(), Default::default())
+    }
+
+    #[cfg(unix)]
+    fn assert_capture_argv0(
+        backend: &ProxyCredentialCaptureBackend,
+        expected_argv0: &str,
+        expected_secret: &str,
+    ) -> Result<()> {
+        let entry = &backend.entries["argv0_fixture"];
+        assert_eq!(
+            entry.source.command_path(),
+            std::fs::canonicalize("/bin/sh").map_err(NonoError::Io)?
+        );
+        let request = nono_proxy::capture::CredentialCaptureRequest {
+            credential_name: "argv0_fixture".to_string(),
+            route_id: "argv0_fixture".to_string(),
+            request_host: "example.com".to_string(),
+            request_path: expected_argv0.to_string(),
+            request_method: "GET".to_string(),
+            session_id: String::new(),
+            cache_scope: String::new(),
+        };
+        let response = nono_proxy::capture::CredentialCaptureBackend::capture(backend, request)
+            .map_err(|err| NonoError::SandboxInit(err.to_string()))?;
+        assert_capture_secret(&response, expected_secret);
+        Ok(())
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn credential_capture_preserves_absolute_and_expanded_command_argv0() -> Result<()> {
+        let temp = tempfile::tempdir().map_err(NonoError::Io)?;
+        let helper = temp.path().join("capture-argv0-helper");
+        std::os::unix::fs::symlink("/bin/sh", &helper).map_err(NonoError::Io)?;
+        let expected = helper.to_string_lossy().into_owned();
+        let backend = capture_argv0_backend(expected.clone(), CAPTURE_ARGV0_SCRIPT, false)?;
+        assert_capture_argv0(&backend, &expected, "capture-token")?;
+
+        let expanded_backend = {
+            let _lock = crate::test_env::ENV_LOCK
+                .lock()
+                .unwrap_or_else(|poisoned| poisoned.into_inner());
+            let _env =
+                crate::test_env::EnvVarGuard::set_all(&[("NONO_CAPTURE_ARGV0_HELPER", &expected)]);
+            capture_argv0_backend(
+                "$NONO_CAPTURE_ARGV0_HELPER".to_string(),
+                CAPTURE_ARGV0_SCRIPT,
+                false,
+            )?
+        };
+        assert_capture_argv0(&expanded_backend, &expected, "capture-token")?;
+        Ok(())
+    }
